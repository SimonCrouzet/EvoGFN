# Local working directories — never committed
notes/
manuscript/
archived/

# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Environments.
# No trailing slash: a large environment is often kept on another filesystem
# and symlinked in, and a pattern ending in "/" matches directories only, so
# the symlink itself would show up as untracked.
.venv
venv
.python-version

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/

# Type checking / linting caches
.mypy_cache/
.ruff_cache/
.dmypy.json

# Jupyter — notebooks are stored as jupytext-paired .py scripts; the .ipynb
# files are generated artifacts and must not be committed.
*.ipynb
.ipynb_checkpoints/

# Experiment outputs
# outputs/ and multirun/ are Hydra's run and sweep directories.
outputs/
multirun/
wandb/
mlruns/
lightning_logs/
*.ckpt
*.pt

# Dataset cache (downloaded landscapes, e.g. GB1).
# Exclude the contents rather than the directory itself, so the negation below
# can re-include the placeholder — a negation cannot rescue a file whose parent
# directory is itself excluded.
data/*
!data/.gitkeep

# Documentation build
site/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
!.vscode/extensions.json
results/
logs/

# Agent worktrees, created and removed per task.
.claude/worktrees/
